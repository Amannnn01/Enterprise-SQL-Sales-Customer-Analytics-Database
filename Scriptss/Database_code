-- Step 1: Clean up accidental schemas in master
USE master;
GO

IF EXISTS (SELECT * FROM sys.schemas WHERE name = 'bronze') DROP SCHEMA bronze;
IF EXISTS (SELECT * FROM sys.schemas WHERE name = 'silver') DROP SCHEMA silver;
IF EXISTS (SELECT * FROM sys.schemas WHERE name = 'gold') DROP SCHEMA gold;
GO

-- Step 2: Reset DataWarehouse database
IF EXISTS (SELECT name FROM sys.databases WHERE name = 'DataWarehouse')
BEGIN
    ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE DataWarehouse;
END
GO

CREATE DATABASE DataWarehouse;
GO

-- Step 3: Create schemas inside DataWarehouse
USE DataWarehouse;
GO

CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO

